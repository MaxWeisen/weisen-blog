---
import '@/styles/global.css'

interface Props {
  pageTitle: string
}

const { pageTitle = '/weisen-blog/' } = Astro.props
---

<meta charset="utf-8" />
<link
  rel="icon"
  type="image/svg+xml"
  href="/favicon.svg"
/>
<meta
  name="viewport"
  content="width=device-width"
/>
<meta
  name="generator"
  content={Astro.generator}
/>
<title>{pageTitle}</title>
