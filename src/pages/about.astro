---
import BaseHead from '@/components/BaseHead.astro'

const pageTitle = 'weisen-blog/about'

const identity = {
  firstName: 'Max',
  location: 'Southern California',
  occupation: 'Software Engineer',
  hobbies: [
    'engine building',
    'camping',
    'home improvement',
    'spending time with my dog'
  ]
}

const skills = [
  'JavaScript',
  'Vue',
  'React',
  'Astro',
  'Ionic',
  'Vitest',
  'Jest',
  'Mysql'
]

const skillColor = 'navy'
const fontWeight = 'bold'
---

<html lang="en">
  <head>
    <BaseHead pageTitle={pageTitle} />
  </head>
  <body>
    <h1>{pageTitle}</h1>
    <ul>
      <li>My name is {identity.firstName}.</li>
      <li>I live in {identity.location} working as a {identity.occupation}.</li>
      {
        identity.hobbies.length >= 2 && (
          <li>
            Two of my favorite hobbies are
            {identity.hobbies[0]} and {identity.hobbies[1]}
          </li>
        )
      }
    </ul>

    <p>My skills are:</p>
    <ul>
      {skills.map((skill) => <li class="skill">{skill}</li>)}
    </ul>
  </body>
</html>
